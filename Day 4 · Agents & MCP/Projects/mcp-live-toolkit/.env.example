LOCAL_LLM_BASE_URL=http://localhost:1234/v1

# Only needed if you select the Gemini provider in the app.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Where the standalone MCP server listens, and where the chat app's MCP
# client looks for it. Change these together if 8765 is already taken.
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765
