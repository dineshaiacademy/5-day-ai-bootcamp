# Required — the independent agent (agent/agent.py) uses the native Gemini
# SDK. Get a free key at https://aistudio.google.com/apikey
GAISTUDIO_API_KEY=

# Where the standalone MCP server listens, and where the agent's MCP client
# looks for it. Change these together if 8770 is already taken (e.g. by the
# sibling mcp-live-toolkit project, which defaults to 8765).
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8770
